{
  "name": "aiquad",
  "version": "0.4.12",
  "description": "",
  "main": "dist/main/index.js",
  "author": "WW-Ares and AI collaborators",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WW-Ares/AIQuad.git"
  },
  "homepage": "https://github.com/WW-Ares/AIQuad#readme",
  "bugs": {
    "url": "https://github.com/WW-Ares/AIQuad/issues"
  },
  "keywords": [
    "electron",
    "chrome",
    "multi-ai",
    "split-view",
    "windows",
    "win32"
  ],
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "dev": "electron .",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dist": "npm run clean && npm run build && electron-builder",
    "release:notes": "node scripts/release-notes.js",
    "release:check": "node scripts/post-release-check.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "electron-updater": "~6.8.9",
    "koffi": "~3.2.1"
  },
  "devDependencies": {
    "@types/node": "~26.5.1",
    "electron": "~44.3.0",
    "electron-builder": "~26.15.3",
    "typescript": "~7.0.2"
  },
  "build": {
    "appId": "com.aiquad.app",
    "productName": "AIQuad",
    "directories": {
      "output": "build"
    },
    "electronLanguages": [
      "zh-CN",
      "zh-TW",
      "en-US"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/renderer/icon.ico",
      "artifactName": "AIQuad-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "AIQuad-Portable-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "WW-Ares",
      "repo": "AIQuad"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "package.json"
    ],
    "electronDist": "node_modules/electron/dist"
  }
}
